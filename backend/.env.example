# Local backend configuration.
# Use the connection string for your local PostgreSQL database.
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?sslmode=disable

# Generate a long random value. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret

# Local frontend origin; on Render set FRONTEND_URL to your deployed frontend URL.
FRONTEND_URL=http://localhost:5173

# On local HTTP, keep false. On Render HTTPS, set true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
